# ============================================================
# InstalliQ.ai — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- App ---
NODE_ENV=development            # development | staging | production
PORT=5000                       # Server port (Replit uses 5000)
BASE_URL=                       # Public URL (e.g. https://installiq.ai). Auto-detected if blank.
SESSION_SECRET=                 # REQUIRED — random string, min 32 chars

# --- Database (one is required) ---
DATABASE_URL=                   # PostgreSQL connection string
DIGITALOCEAN_DATABASE_URL=      # DigitalOcean managed Postgres (enables SSL + TLS bypass)

# --- Email — SMTP (required for sending) ---
SMTP_HOST=smtp0001.neo.space    # SMTP server host
SMTP_PORT=587                   # SMTP port (587 STARTTLS / 465 SSL)
SMTP_USER=                      # REQUIRED — SMTP login username
SMTP_PASS=                      # REQUIRED — SMTP login password
SMTP_FROM=                      # From address (defaults to SMTP_USER)

# --- Email — SendGrid (optional, for sender verification) ---
SENDGRID_API_KEY=

# --- OpenAI (optional, enables AI features) ---
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=            # Pre-built scheduling assistant ID

# --- Google OAuth (optional, enables calendar sync) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- DigitalOcean Spaces / S3 (optional, file storage) ---
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=productionstorage
DO_SPACES_CDN_URL=https://productionstorage.nyc3.digitaloceanspaces.com
DO_SPACES_KEY=
DO_SPACES_SECRET=

# --- Razorpay (optional, payment processing) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Weather (optional) ---
OPENWEATHER_API_KEY=

# --- Frontend (prefix with VITE_ for client-side access) ---
VITE_GOOGLE_MAPS_API_KEY=
